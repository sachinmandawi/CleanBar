<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CleanBar" parent="android:Theme.Material.NoActionBar">
        <!-- Transparent status bar so our app controls it fully -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Pure black/dark window background — prevents white flash on cold start -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <!-- Required on Android 10+ to actually draw behind system bars -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Keep status bar icons light based on our dark background -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Prevent Android 10+ and Android 15 edge contrast scrim white flicker -->
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <!-- Android 12+ Splash Screen background -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@android:color/black</item>
    </style>
</resources>
